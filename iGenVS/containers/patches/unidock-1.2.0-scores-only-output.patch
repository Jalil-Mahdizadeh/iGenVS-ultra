+/* Write one best score per GPU ligand without serializing pose coordinates. */
+void Vina::write_scores_gpu(const std::vector<std::string>& ligand_names,
+                            const std::string& score_file) {
+    assert(ligand_names.size() == m_poses_gpu.size());
+    std::ofstream output(score_file, std::ios::app);
+    if (!output.is_open()) throw file_error(score_file, false);
+    output << std::setprecision(17);
+    VINA_RANGE(i, 0, ligand_names.size()) {
+        output << ligand_names[i] << '\t';
+        if (!m_poses_gpu[i].empty() && not_max(m_poses_gpu[i][0].e))
+            output << m_poses_gpu[i][0].e;
+        else
+            output << "nan";
+        output << '\n';
+    }
+}
