#!/usr/bin/env bash
set -euo pipefail

phase_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
repo_root="$(cd "${phase_dir}/.." && pwd)"
image="${IGENVS_IMAGE:-/nobackup/proj/disk/theo-storage/personal/jalil/iGenVS/containers/iGenVS.SIF}"

python_path="${phase_dir}/src:${repo_root}/iGenVS/iGen3/src:${repo_root}/iGenVS/src"
exec apptainer exec --nv --bind "${repo_root}:${repo_root}" \
  --env "PYTHONPATH=${python_path}" "${image}" \
  python3 -m igenvs_rl "$@"
