# This file is preconfigured for the supplied Arrhenius allocation and path.
# Copy it only if you want a separate local override, then source that copy.
# Keep the SIF, source data, work products, and checkpoints in project storage,
# never in the 30 GiB home directory.
export NAISS_PROJECT="naiss2025-3-10-gpu"
export PROJECT_ROOT="/nobackup/proj/disk/theo-storage/personal/jalil/gMolAI"
export CODE_DIR="${PROJECT_ROOT}/gMolAI-retrain"
export SIF_PATH="${PROJECT_ROOT}/containers/gmolai-pyg-25.09-arm64.sif"
export CONFIG_PATH="${CODE_DIR}/configs/retrain.yaml"
export GMOLAI_PLAN_PATH="${CODE_DIR}/configs/representation-v1.yaml"

# Validated representation run. Automatic export verifies the promoted
# checkpoint, train-only calibrator, and selection record before use.
export GMOLAI_RUN_DIR="${CODE_DIR}/runs/combined-zinc-pubchem-representation-pilot-mean-node-contrastive-001-desc050"
export GMOLAI_CHECKPOINT_NAME="checkpoints/step-000010000.pt"
export APPTAINER_CACHEDIR="${PROJECT_ROOT}/.apptainer-cache"

# Optional extra comma-separated Apptainer bind specifications. PROJECT_ROOT is
# always bound. Example: /another/allocated/path:/flash
export GMOLAI_EXTRA_BINDS=""

# Throttle arrays to respect the allocation and shared-filesystem load.
# CPU-heavy stages run on arm64 GPU nodes for architecture compatibility.
# Keep the initial concurrency to one four-GPU node's worth of allocation.
export CANONICAL_MAX_CONCURRENT=4
export DEDUP_MAX_CONCURRENT=4
export FEATURIZE_MAX_CONCURRENT=4

# Pause after graph creation for manifest/quota review before training.
export AUTO_SUBMIT_TRAIN=0
